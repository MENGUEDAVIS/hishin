{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "HI-SHIN single-task production pilot with Cognito and persistent EFS",
  "Parameters": {
    "VpcId": {
      "Type": "String"
    },
    "SubnetA": {
      "Type": "String"
    },
    "SubnetB": {
      "Type": "String"
    },
    "HostedZoneId": {
      "Type": "String"
    },
    "ImageUri": {
      "Type": "String"
    }
  },
  "Resources": {
    "AppLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/hishin/prod/app",
        "RetentionInDays": 7
      }
    },
    "TranscribeBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire",
              "Status": "Enabled",
              "ExpirationInDays": 7,
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Pool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": "hishin-prod",
        "UserPoolTier": "ESSENTIALS",
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "Schema": [
          {
            "Name": "email",
            "Required": true,
            "Mutable": true
          }
        ],
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": false
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "PoolDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "Domain": {
          "Fn::Sub": "hishin-${AWS::AccountId}-prod"
        },
        "UserPoolId": {
          "Ref": "Pool"
        },
        "ManagedLoginVersion": 2
      }
    },
    "PoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "Pool"
        },
        "ClientName": "hishin-web",
        "GenerateSecret": true,
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "email",
          "profile"
        ],
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "CallbackURLs": [
          "https://hishin.globalnavigator.app/oauth2/idpresponse"
        ],
        "LogoutURLs": [
          "https://hishin.globalnavigator.app/logged-out"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "RefreshTokenValidity": 1
      }
    },
    "Certificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": "hishin.globalnavigator.app",
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [
          {
            "DomainName": "hishin.globalnavigator.app",
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          }
        ]
      }
    },
    "AlbSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Public HTTPS only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "TaskSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "App only from ALB",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3001,
            "ToPort": 3001,
            "SourceSecurityGroupId": {
              "Ref": "AlbSG"
            }
          }
        ]
      }
    },
    "EfsSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "NFS only from app",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 2049,
            "ToPort": 2049,
            "SourceSecurityGroupId": {
              "Ref": "TaskSG"
            }
          }
        ]
      }
    },
    "FileSystem": {
      "Type": "AWS::EFS::FileSystem",
      "Properties": {
        "Encrypted": true,
        "PerformanceMode": "generalPurpose",
        "ThroughputMode": "bursting",
        "BackupPolicy": {
          "Status": "ENABLED"
        },
        "FileSystemPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "elasticfilesystem:*",
              "Resource": "*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AccessPoint": {
      "Type": "AWS::EFS::AccessPoint",
      "Properties": {
        "FileSystemId": {
          "Ref": "FileSystem"
        },
        "PosixUser": {
          "Uid": "1000",
          "Gid": "1000"
        },
        "RootDirectory": {
          "Path": "/hishin",
          "CreationInfo": {
            "OwnerUid": "1000",
            "OwnerGid": "1000",
            "Permissions": "0750"
          }
        }
      }
    },
    "MountA": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "FileSystem"
        },
        "SubnetId": {
          "Ref": "SubnetA"
        },
        "SecurityGroups": [
          {
            "Ref": "EfsSG"
          }
        ]
      }
    },
    "MountB": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "FileSystem"
        },
        "SubnetId": {
          "Ref": "SubnetB"
        },
        "SecurityGroups": [
          {
            "Ref": "EfsSG"
          }
        ]
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "hishin-prod",
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSG"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "1800"
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ]
      }
    },
    "Target": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 3001,
        "TargetType": "ip",
        "HealthCheckPath": "/healthz",
        "HealthCheckIntervalSeconds": 30,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "1800"
          }
        ]
      }
    },
    "Https": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "Certificate"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "authenticate-cognito",
            "Order": 1,
            "AuthenticateCognitoConfig": {
              "UserPoolArn": {
                "Fn::GetAtt": [
                  "Pool",
                  "Arn"
                ]
              },
              "UserPoolClientId": {
                "Ref": "PoolClient"
              },
              "UserPoolDomain": {
                "Ref": "PoolDomain"
              },
              "Scope": "openid email profile",
              "SessionTimeout": 28800,
              "OnUnauthenticatedRequest": "authenticate"
            }
          },
          {
            "Type": "forward",
            "Order": 2,
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "Http": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "PublicPages": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Https"
        },
        "Priority": 1,
        "Conditions": [
          {
            "Field": "path-pattern",
            "Values": [
              "/logged-out",
              "/"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "ApiAuth": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Https"
        },
        "Priority": 2,
        "Conditions": [
          {
            "Field": "path-pattern",
            "Values": [
              "/api/*"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "authenticate-cognito",
            "Order": 1,
            "AuthenticateCognitoConfig": {
              "UserPoolArn": {
                "Fn::GetAtt": [
                  "Pool",
                  "Arn"
                ]
              },
              "UserPoolClientId": {
                "Ref": "PoolClient"
              },
              "UserPoolDomain": {
                "Ref": "PoolDomain"
              },
              "Scope": "openid email profile",
              "SessionTimeout": 3600,
              "OnUnauthenticatedRequest": "deny"
            }
          },
          {
            "Type": "forward",
            "Order": 2,
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "scoped",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/hishin-prod"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "AppLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "scoped",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "elasticfilesystem:ClientMount",
                    "elasticfilesystem:ClientWrite"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "FileSystem",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "elasticfilesystem:AccessPointArn": {
                        "Fn::GetAtt": [
                          "AccessPoint",
                          "Arn"
                        ]
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${TranscribeBucket.Arn}/hishin/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "transcribe:StartTranscriptionJob",
                    "transcribe:GetTranscriptionJob"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:transcribe:${AWS::Region}:${AWS::AccountId}:transcription-job/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "polly:SynthesizeSpeech",
                    "polly:DescribeVoices"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:InvokeModelWithResponseStream"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:bedrock:*::foundation-model/anthropic.claude-sonnet-4-6"
                    },
                    {
                      "Fn::Sub": "arn:aws:bedrock:*::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0"
                    },
                    {
                      "Fn::Sub": "arn:aws:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/us.anthropic.claude-sonnet-4-6"
                    },
                    {
                      "Fn::Sub": "arn:aws:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "hishin-prod"
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "hishin-prod",
        "Cpu": "512",
        "Memory": "2048",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "Volumes": [
          {
            "Name": "data",
            "EFSVolumeConfiguration": {
              "FilesystemId": {
                "Ref": "FileSystem"
              },
              "TransitEncryption": "ENABLED",
              "AuthorizationConfig": {
                "AccessPointId": {
                  "Ref": "AccessPoint"
                },
                "IAM": "ENABLED"
              }
            }
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "app",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "StopTimeout": 120,
            "PortMappings": [
              {
                "ContainerPort": 3001
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "data",
                "ContainerPath": "/data"
              }
            ],
            "Environment": [
              {
                "Name": "AUTH_MODE",
                "Value": "alb"
              },
              {
                "Name": "APP_ORIGIN",
                "Value": "https://hishin.globalnavigator.app"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "ALB_ARN",
                "Value": {
                  "Ref": "Alb"
                }
              },
              {
                "Name": "COGNITO_CLIENT_ID",
                "Value": {
                  "Ref": "PoolClient"
                }
              },
              {
                "Name": "COGNITO_DOMAIN",
                "Value": {
                  "Fn::Sub": "https://${PoolDomain}.auth.${AWS::Region}.amazoncognito.com"
                }
              },
              {
                "Name": "TRANSCRIBE_S3_BUCKET",
                "Value": {
                  "Ref": "TranscribeBucket"
                }
              },
              {
                "Name": "BEDROCK_DIRECTOR_MODEL_ID",
                "Value": "us.anthropic.claude-sonnet-4-6"
              },
              {
                "Name": "BEDROCK_CRITIC_MODEL_ID",
                "Value": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
              },
              {
                "Name": "MAX_REVISION_ROUNDS",
                "Value": "1"
              },
              {
                "Name": "MEDIA_TIMEOUT_MS",
                "Value": "600000"
              },
              {
                "Name": "MAX_UPLOAD_MB",
                "Value": "500"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "AppLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "app"
              }
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "hishin-prod",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "DesiredCount": 1,
        "HealthCheckGracePeriodSeconds": 90,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "SubnetA"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskSG"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "app",
            "ContainerPort": 3001,
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      },
      "DependsOn": [
        "Https",
        "MountA",
        "MountB"
      ]
    },
    "Dns": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": "hishin.globalnavigator.app",
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "Alb",
              "DNSName"
            ]
          },
          "HostedZoneId": {
            "Fn::GetAtt": [
              "Alb",
              "CanonicalHostedZoneID"
            ]
          }
        }
      }
    },
    "PoolBranding": {
      "Type": "AWS::Cognito::ManagedLoginBranding",
      "DependsOn": "PoolDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "Pool"
        },
        "ClientId": {
          "Ref": "PoolClient"
        },
        "Settings": {
          "components": {
            "secondaryButton": {
              "lightMode": {
                "hover": {
                  "backgroundColor": "f8ece6ff",
                  "borderColor": "963a1cff",
                  "textColor": "963a1cff"
                },
                "defaults": {
                  "backgroundColor": "fcfcf8ff",
                  "borderColor": "b84423ff",
                  "textColor": "b84423ff"
                },
                "active": {
                  "backgroundColor": "f8ece6ff",
                  "borderColor": "963a1cff",
                  "textColor": "963a1cff"
                }
              },
              "darkMode": {
                "hover": {
                  "backgroundColor": "192534ff",
                  "borderColor": "89bdeeff",
                  "textColor": "89bdeeff"
                },
                "defaults": {
                  "backgroundColor": "0f1b2aff",
                  "borderColor": "539fe5ff",
                  "textColor": "539fe5ff"
                },
                "active": {
                  "backgroundColor": "354150ff",
                  "borderColor": "89bdeeff",
                  "textColor": "89bdeeff"
                }
              }
            },
            "form": {
              "lightMode": {
                "backgroundColor": "fcfcf8ff",
                "borderColor": "deded4ff"
              },
              "borderRadius": 12.0,
              "backgroundImage": {
                "enabled": false
              },
              "logo": {
                "location": "CENTER",
                "position": "TOP",
                "enabled": true,
                "formInclusion": "IN"
              },
              "darkMode": {
                "backgroundColor": "0f1b2aff",
                "borderColor": "424650ff"
              }
            },
            "alert": {
              "lightMode": {
                "error": {
                  "backgroundColor": "fff7f7ff",
                  "borderColor": "d91515ff"
                }
              },
              "borderRadius": 12.0,
              "darkMode": {
                "error": {
                  "backgroundColor": "1a0000ff",
                  "borderColor": "eb6f6fff"
                }
              }
            },
            "favicon": {
              "enabledTypes": [
                "ICO",
                "SVG"
              ]
            },
            "pageBackground": {
              "image": {
                "enabled": false
              },
              "lightMode": {
                "color": "f5f4efff"
              },
              "darkMode": {
                "color": "0f1b2aff"
              }
            },
            "pageText": {
              "lightMode": {
                "bodyColor": "6c6c64ff",
                "headingColor": "252722ff",
                "descriptionColor": "6c6c64ff"
              },
              "darkMode": {
                "bodyColor": "b6bec9ff",
                "headingColor": "d1d5dbff",
                "descriptionColor": "b6bec9ff"
              }
            },
            "phoneNumberSelector": {
              "displayType": "TEXT"
            },
            "primaryButton": {
              "lightMode": {
                "hover": {
                  "backgroundColor": "963a1cff",
                  "textColor": "ffffffff"
                },
                "defaults": {
                  "backgroundColor": "b84423ff",
                  "textColor": "ffffffff"
                },
