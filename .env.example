AWS_REGION=us-east-1
# Use the AWS SDK default credential chain; never paste credentials here.
# Set model IDs or inference-profile ARNs after checking account availability.
# Verified available in this account's Bedrock catalog (us-east-1) at step 4:
BEDROCK_DIRECTOR_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_CRITIC_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
TRANSCRIBE_S3_BUCKET=
TRANSCRIBE_LANGUAGE_CODE=fr-FR
# Photo-segment captions need drawtext (libfreetype), not built into the plain
# ffmpeg Homebrew formula. Install `ffmpeg-full` (bottled, keg-only) and point
# these at its binaries, e.g. "$(brew --prefix ffmpeg-full)/bin/ffmpeg". Plain
# `ffmpeg`/`ffprobe` still works for every other pipeline step.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DATA_DIR=./data
HOST=127.0.0.1
PORT=3001
MAX_REVISION_ROUNDS=2
LOG_LEVEL=info
# Optional pricing configuration in USD per million tokens. Blank = unknown.
DIRECTOR_INPUT_USD_PER_MILLION=
DIRECTOR_OUTPUT_USD_PER_MILLION=
CRITIC_INPUT_USD_PER_MILLION=
CRITIC_OUTPUT_USD_PER_MILLION=
