{
  "name": "hi-shin",
  "version": "0.1.0",
  "private": true,
  "description": "HI-SHIN — The Agentic Video Production Desk",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "check:setup": "node scripts/check-setup.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "npm test -- --testPathPatterns=tests/integration",
    "test:unit": "npm test -- --testPathPatterns=tests/unit",
    "test:agents": "node --env-file=.env --import tsx tests/integration/agent-tools.spec.ts",
    "server": "node --env-file=.env --import tsx src/server/index.ts",
    "ui:dev": "vite --config ui/vite.config.ts ui",
    "ui:build": "vite build --config ui/vite.config.ts ui",
    "test:history": "node --import tsx --test tests/integration/history.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1112.0",
    "@aws-sdk/client-polly": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/client-transcribe": "^3.0.0",
    "@strands-agents/sdk": "1.16.0",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "pino": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jest": "^30.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
